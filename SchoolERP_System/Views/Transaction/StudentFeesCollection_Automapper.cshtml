        function updateGrossTotal_rowwise1() {
                var totalmonthfees = $('#totalAmount').text() == "" ? 0.00 : parseFloat($('#totalAmount').text());
                var payAmt = $('#txtpayamountRow').val() == "" ? 0.00 : parseFloat($('#txtpayamountRow').val());
                var lessmoreAmt = $('#txtlessormoreRow').val() == "" ? 0.00 : parseFloat($('#txtlessormoreRow').val());

            var netAmt = $('#txtnetamountRow').val() == "" ? 0.00 : parseFloat($('#txtnetamountRow').val());
            var letAmt = $('#txtlateamountRow').val() == "" ? 0.00 : parseFloat($('#txtlateamountRow').val());
            var disAmt = $('#txtdiscountamountRow').val() == "" ? 0.00 : parseFloat($('#txtdiscountamountRow').val());
                // var otherAmt = $('#txtOtherAmount').val() == "" ? 0.00 : parseFloat($('#txtOtherAmount').val());

                if (totalmonthfees >= payAmt)
                    $('#txtlessormoreRow').val((totalmonthfees - payAmt) == 0 ? 0 : ('- ' + (totalmonthfees - payAmt)));
                else
                    $('#txtlessormoreRow').val('+ ' + (payAmt - totalmonthfees));

                var amount = parseFloat(payAmt) || 0;
                $('#txtnetamountRow').val(amount.toFixed(2));

                var tAmt = parseFloat($('#txtnetamountRow').val()) + parseFloat($('#txtlateamountRow').val()); // + parseFloat(otherAmt);
            $('#txtgrossamountRow').val((tAmt - disAmt).toFixed(2));
            }
        function updateGrossTotal_rowwise222() {
                var dueAmount = parseFloat($("#dueamounts").attr("dueamt")) || 0;
                var totalmonthfees = parseFloat($('#totalAmount').text()) || 0;
                var payAmt = parseFloat($('#txtpayamountRow').val()) || 0;
                var lateAmt = parseFloat($('#txtlateamountRow').val()) || 0;
                var disAmt = parseFloat($('#txtdiscountamountRow').val()) || 0;

                // Less / More Amount
                if (payAmt < totalmonthfees) {
                    $('#txtlessormoreRow').val('-' + (totalmonthfees - (payAmt + dueAmount)).toFixed(2));
                }
                else if (payAmt > totalmonthfees) {
                    $('#txtlessormoreRow').val('+' + ((payAmt + dueAmount) - totalmonthfees).toFixed(2));
                }
                else {
                    $('#txtlessormoreRow').val('0.00');
                }

                // Net Amount
                $('#txtnetamountRow').val((payAmt + dueAmount).toFixed(2));

                // Gross Amount
                var grossAmt = (payAmt + dueAmount) + lateAmt - disAmt;
                $('#txtgrossamountRow').val(grossAmt.toFixed(2));
            }
        function updateGrossTotal_rowwise() {

                var balance = parseFloat($("#dueamounts").attr("dueamt")) || 0;

                var totalMonthFees = parseFloat($('#totalAmount').text()) || 0;
                var payAmt = parseFloat($('#txtpayamountRow').val()) || 0;
                var lateAmt = parseFloat($('#txtlateamountRow').val()) || 0;
                var disAmt = parseFloat($('#txtdiscountamountRow').val()) || 0;

                // Net Amount
                var netAmount = totalMonthFees;

                if (balance < 0) {
                    netAmount += Math.abs(balance);   // Previous Due
                }
                else if (balance > 0) {
                    netAmount -= balance;             // Previous Advance
                }

                $('#txtnetamountRow').val(netAmount.toFixed(2));

                // Gross Amount (Final Payable)
                var grossAmt = netAmount + lateAmt - disAmt;

                $('#txtgrossamountRow').val(grossAmt.toFixed(2));

                // Less / Exceeded should compare against Gross Amount
                var difference = payAmt - grossAmt;

                if (difference > 0) {
                    $('#txtlessormoreRow').val('+' + difference.toFixed(2));
                }
                else if (difference < 0) {
                    $('#txtlessormoreRow').val(difference.toFixed(2));
                }
                else {
                    $('#txtlessormoreRow').val('0.00');
                }
            }
