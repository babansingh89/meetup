@section body_scripts{
    <script type="text/javascript">

        $(document).ready(function () {
            $(document).on('change', '#ddlPayMode', function () {
                var payMode = $('#ddlPayMode').val();
                    if (payMode == "C" || payMode == "0") {
                        $('#txtTransactionno').val('');
                        $('#txtTransactiondate').val('');
                        $('#txtTransactionno').prop('disabled', true);
                        $('#txtTransactiondate').prop('disabled', true);
                    }
                    else {
                        $('#txtTransactionno').prop('disabled', false);
                        $('#txtTransactiondate').prop('disabled', false);

                    }
            });

        $(document).on('click', '#btnGenerateFee', function () {
                hideAlert();
                var selectedMonths = [];

                var _RegNo = $('#txtRegNo').val();
                if (_RegNo == '') {
                    FormSuccessError1("Please enter Reg No.", "Error", "errorBlock", "div_Scroll");
                    $('#txtRegNo').focus();
                    return false;
                }


                // Get all checked checkboxes with name 'months' that are not disabled
                $('input[name="months"]:checked:not(:disabled)').each(function () {
                    selectedMonths.push($(this).val());
                });

            if (selectedMonths.length == 0) {

                alert('Please select month !');
                $('#tblfee tbody').empty();
                updateTotal(selectedMonths.length);
                return false;
                }


    $.ajax({
        type: "POST",
        url: '@Url.Action("GetStudentFee_Auto", "Transaction")',
        data: JSON.stringify({ SR_No: _RegNo, OptedMonth: selectedMonths.join(',')  }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        cache: false,
        success: function (data) {

            if (data.length > 0) {

                if (parseInt(data[3]) === 1) {
                    var result = confirm(
                        "You are about to complete the fee collection for the current academic session.\n\n" +
                        "Please ensure all previous dues are cleared or advances are adjusted before final payment.\n\n" +
                        "Do you want to continue?"
                    );

                    if (!result) {
                        return false;
                    }
                }

                $('#tblfee tbody').empty();

                var cnt = 0;

                $.each(data[1], function (rowIndex, val) {

                    cnt++;

                    var row = `
            <tr id="${val.FeeHeadID}">
                <td style="width:30px;text-align:center;font-weight:bold;">${cnt}</td>
                <td style="text-align:right;font-weight:bold;">${val.FeeHeadName}</td>
                <td class="amount" style="text-align:right;font-weight:bold;">${parseFloat(val.Ins_Amt).toFixed(2)}</td>
            </tr>`;

                    $('#tblfee tbody').append(row);

                });

                var balance = parseFloat(data[2]) || 0;

                var previousBalanceRow = `
        <tr id="previousBalanceRow">
            <td colspan="2" style="text-align:right;font-weight:bold;">
                ${balance < 0 ? 'Previous Due (B)' : 'Previous Advance (B)'}
            </td>
            <td>
                <div style="display:flex;justify-content:flex-end;align-items:center;gap:10px;">
                    <span id="dueamounts"
                          dueamt="${balance}"
                          style="font-style:italic;color:${balance < 0 ? 'red' : 'green'};">
                        ${Math.abs(balance).toFixed(2)}
                    </span>
                </div>
            </td>
        </tr>`;

                var netamountRow = `
        <tr id="netamountRow">
            <td colspan="2" style="text-align:right;font-weight:bold;">
                Net Amount  (A ${balance < 0 ? '+' : '-'} B)
            </td>
            <td>
                <input type="text"
                       id="txtnetamountRow"
                       class="form-control"
                       style="text-align:right;width:20%;float:right;font-weight:bold;background:#e9e9e9;"
                       value="0.00"
                       readonly />
            </td>
        </tr>`;

                var lateamountRow = `
        <tr id="lateamountRow">
            <td colspan="2" style="text-align:right;font-weight:bold;">
                Late Fee  (+C)
            </td>
            <td>
                <input type="text"
                       id="txtlateamountRow"
                       class="form-control clsfeesamt"
                       style="text-align:right;width:20%;float:right;"
                       value="0.00" />
            </td>
        </tr>`;

                var discountamountRow = `
        <tr id="discountamountRow">
            <td colspan="2" style="text-align:right;font-weight:bold;">
                Discount  (-D)
            </td>
            <td>
                <input type="text"
                       id="txtdiscountamountRow"
                       class="form-control clsfeesamt"
                       style="text-align:right;width:20%;float:right;"
                       value="0.00" />
            </td>
        </tr>`;

                var grossamountRow = `
        <tr id="grossamountRow">
            <td colspan="2" style="text-align:right;font-weight:bold;">
                Gross Amount  ((A±B)+C-D)
            </td>
            <td>
                <input type="text"
                       id="txtgrossamountRow"
                       class="form-control"
                       style="text-align:right;width:20%;float:right;font-weight:bold;background:#e9e9e9;"
                       value="0.00"
                       readonly />
            </td>
        </tr>`;

                var payamountRow = `
        <tr id="payamountRow">
            <td colspan="2" style="text-align:right;font-weight:bold;">
                Payment Received  (E)
            </td>
            <td>
                <input type="text"
                       id="txtpayamountRow"
                       class="form-control clsfeesamt"
                       style="text-align:right;width:20%;float:right;"
                       value="0.00" />
            </td>
        </tr>`;

                var balanceRow = `
        <tr id="balanceRow">
            <td colspan="2" style="text-align:right;font-weight:bold;">
                Balance  (E - Gross Amount)
            </td>
            <td>
                <input type="text"
                       id="txtlessormoreRow"
                       class="form-control"
                       style="text-align:right;width:20%;float:right;font-weight:bold;background:#e9e9e9;"
                       value="0.00"
                       readonly />
            </td>
        </tr>`;

                if (selectedMonths.length > 0) {

                    //$('#tblfee tfoot').empty();

                    $('#previousBalanceRow').remove();
                    $('#netamountRow').remove();
                    $('#lateamountRow').remove();
                    $('#discountamountRow').remove();
                    $('#grossamountRow').remove();
                    $('#payamountRow').remove();
                    $('#balanceRow').remove();

                    $('#tblfee tfoot').append(previousBalanceRow);
                    $('#tblfee tfoot').append(netamountRow);
                    $('#tblfee tfoot').append(lateamountRow);
                    $('#tblfee tfoot').append(discountamountRow);
                    $('#tblfee tfoot').append(grossamountRow);
                    $('#tblfee tfoot').append(payamountRow);
                    $('#tblfee tfoot').append(balanceRow);

                    updateTotal_rowwise(selectedMonths.length);
                }

            }
            else {

                FormSuccessError1("Please enter correct Reg No.", "Error", "errorBlock", "div_Scroll");
                $('#txtRegNo').focus();
                return false;

            }
        },
        error: function (error) {
            console.error(error);
            //FormSuccessError(error, "Error", "errorBlock");
            return false;
        }
    });






});

        $(document).on('click', '#btnsearch', function () {
        hideAlert();
        var _RegNo = $('#txtRegNo').val();
        if (_RegNo == '') {
            FormSuccessError1("Please enter Reg No.", "Error", "errorBlock", "div_Scroll");
            $('#txtRegNo').focus();
            return false;
        }

        $.ajax({
            type: "POST",
            url: '@Url.Action("GetStudentFee_Auto", "Transaction")',
            data: JSON.stringify({ SR_No: _RegNo, OptedMonth: "" }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            cache: false,
            success: function (data) {

                if (data.length > 0) {
                    $("#hdId").val(data[0][0].SR_ID);
                    $('#txtRegNo').val(data[0][0].SR_RegNo);
                    $('#txtName').val(data[0][0].SR_StudentName);
                    $('#txtclassName').val(data[0][0].ClassName);
                    $('#txtrollno').val(data[0][0].SR_CurrentRollNo);
                    $('#txtSectionName').val(data[0][0].SectionName);
                    $('#txtStreamName').val(data[0][0].StreamName);
                    $('#txtPhNo').val(data[0][0].SR_PhNo);
                    $('#tblfee tbody').empty();

                    BindMonth(data[0][0].Session_ActiveMonth, data[0][0].PayMonth);

                } else {
                    FormSuccessError1("Please enter correct Reg No.", "Error", "errorBlock", "div_Scroll");
                    $('#txtRegNo').focus();
                    return false;
                }
            },
            error: function (error) {
                console.error(error);
                //FormSuccessError(error, "Error", "errorBlock");
                return false;
            }
        });


        });

        $(document).on('click', '.clsconfPrint', function () {
                var selectedMonths = [];

                $('input[name="months"]:checked:not(:disabled)').each(function () {
                    selectedMonths.push($(this).val());
                });

                Print(selectedMonths);
            });
            //save
        $(document).on('click', '#btnSubmitPrint', function () {
            hideAlert();
            var selectedMonths = [];

            var rowCount = $('#tblfee tbody tr').length;

            // Get all checked checkboxes with name 'months' that are not disabled
            $('input[name="months"]:checked:not(:disabled)').each(function () {
                selectedMonths.push($(this).val());
            });

            if (selectedMonths.length == 0) {
                alert('Please select month !'); return false;
            }
            if (rowCount == 0) {
                alert('Please add fee details !'); return false;
            }

            if ($('#txtgrossamountRow').val() <= 0) {
                var netAmount = parseFloat($('#txtnetamountRow').val()) || 0;
                var previousAdvance = parseFloat($("#dueamounts").attr("dueamt")) || 0;
                if (netAmount == 0 && previousAdvance > 0) {
                    // Allow save
                }
                else {
                    alert("Gross Amount should be greater than zero.");
                    return false;
                }
            }


                // Calculate Advance Adjusted
                var advanceAdjustedAmount = 0;
                var previousBalance = parseFloat($("#dueamounts").attr("dueamt")) || 0;
                var totalFee = parseFloat($('#totalAmount').text()) || 0;
                var paymentAmount = parseFloat($('#txtpayamountRow').val()) || 0;

                if (previousBalance > 0) {
                    advanceAdjustedAmount = Math.min(previousBalance, totalFee);
                }

                // Calculate Closing Balance
                var closingBalance = previousBalance + paymentAmount - totalFee;

            $.ajax({
                type: "POST",
                url: '@Url.Action("SaveStudentFeesCollection_Auto", "Transaction")',
                data: JSON.stringify({
                    SR_ID: $("#hdId").val(), TotalFeeAmount: $('#totalAmount').text(), TotalNetPayable: $('#txtpayamountRow').val(), TotalDueAmount: $('#txtlessormoreRow').val(),
                    TotalNetAmount: $('#txtnetamountRow').val(), TotalDiscount: $('#txtdiscountamountRow').val(), TotalLateFee: $('#txtlateamountRow').val(),
                    GrossPaymentAmount: $('#txtgrossamountRow').val(), OtherAmount: 0, AdvanceAdjustedAmount: advanceAdjustedAmount, ClosingBalance: closingBalance,
                    PayMode: $('#ddlPayMode').val(), PayMonth: selectedMonths.join(','),
                    TransactionNo: $('#txtTransactionno').val(), TransactionDate: $('#txtTransactiondate').val(), Remarks: $('#txtRemarks').val()
                }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                cache: false,
                success: function (response) {

                    if (!response.success) {
                        alert(response.message);
                        return;
                    }

                    $(".clsReceiptno").text('Receipt No. : ' + response.receiptNo);
                    $("#hdnReceiptId").val(response.outId); 
                    $("#conModel").modal('show');

                    //if (data != '') {

                    //    if (data.indexOf("-1|") === 0) {
                    //        alert(data.split('|')[1]);
                    //        return;
                    //    }

                    //    $(".clsReceiptno").text('Receipt No. : ' + data);
                    //    $("#conModel").modal();

                    //}
                },
                error: function (error) {
                    console.error(error);
                    return false;
                }
            });

        });

        $(document).on('click', '#btncancel', function () {
            location.reload();
        });
        $(document).on('click', '.clsconfClose', function () {
            location.reload();
        });

        $(document).ready(function () {
        $('.clsfeeamt').on('keypress', function (event) {
            // Allow only numbers (0-9)
            if (event.which < 48 || event.which > 57) {
                event.preventDefault(); // Prevent non-numeric characters
            }
        });

        $('.clsfeeamt').on('keyup', function () {
            updateGrossTotal();
        });
    });
        $(document).ready(function () {
                $('#txtRegNo').autocomplete({
                    source: function (request, response) {

                        $.ajax({
                            url: '@Url.Action("Auto_RegNo", "Transaction")',
                            data: { SR_No: $("#txtRegNo").val() },
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            cache: false,
                            success: function (serverResponse) {
                                var AutoComplete = [];
                                console.log(serverResponse[0]);

                                if ((serverResponse[0]).length > 0) {

                                    $.each(serverResponse[0], function (index, item) {
                                        AutoComplete.push({
                                            label: item.SR_RegNo,
                                            SR_ID: item.SR_ID
                                        });
                                    });

                                    response(AutoComplete);
